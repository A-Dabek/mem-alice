# Copy to .env and fill in. `.env` is gitignored; never commit real values.
#
# Loaded automatically by `pnpm start` (node --env-file-if-exists=.env) and by
# `./prod.sh` (sourced if present). Shell env always overrides .env in prod.sh.

# --- Required for sign-in ---------------------------------------------------
# Entra app registration (SPA) client id.
MS_CLIENT_ID=
# Consumer authority (personal Microsoft accounts). Override only for a tenant.
MS_AUTHORITY=https://login.microsoftonline.com/consumers

# --- Required for the API (production) --------------------------------------
# Comma-separated allowlist of account emails allowed to call /api/milestones.
# Empty => every API request is rejected with 403.
ALLOWED_EMAILS=

# --- Optional ---------------------------------------------------------------
PORT=3001
DB_PATH=data/milestones.db
# Extra allowed mutation origins (comma-separated); same-origin is always OK.
# ALLOWED_ORIGINS=
# DEV ONLY: disables /api/milestones auth. Ignored when NODE_ENV=production.
# AUTH_DISABLED=1
